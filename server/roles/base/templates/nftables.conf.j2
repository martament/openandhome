#!/usr/sbin/nft -f
# {{ ansible_managed }}
# openandhome-Server: nur aus privaten Netzen erreichbar.
flush ruleset

table inet filter {
  set lan4 {
    type ipv4_addr; flags interval
    elements = { {{ oh_allowed_nets_v4 | join(', ') }} }
  }
  set lan6 {
    type ipv6_addr; flags interval
    elements = { {{ oh_allowed_nets_v6 | join(', ') }} }
  }

  chain input {
    type filter hook input priority filter; policy drop;
    ct state established,related accept
    ct state invalid drop
    iif lo accept
    meta l4proto { icmp, ipv6-icmp } accept

    # SSH, MQTT (Sensorboxen), Grafana
    ip saddr @lan4 tcp dport { 22, {{ oh_port_mqtt }}, {{ oh_port_grafana }} } accept
    ip6 saddr @lan6 tcp dport { 22, {{ oh_port_mqtt }}, {{ oh_port_grafana }} } accept
    # NTP, Syslog (Sensorboxen), mDNS
    ip saddr @lan4 udp dport { 123, {{ oh_port_syslog }}, 5353 } accept
    ip6 saddr @lan6 udp dport { 123, {{ oh_port_syslog }}, 5353 } accept
    # DHCPv6-Antworten
    ip6 saddr fe80::/10 udp dport 546 accept
  }

  chain forward {
    type filter hook forward priority filter; policy drop;
  }

  chain output {
    type filter hook output priority filter; policy accept;
  }
}
