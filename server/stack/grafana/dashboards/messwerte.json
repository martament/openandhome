{
  "uid": "oh-messwerte",
  "title": "Sensorboxen – Messwerte",
  "tags": [
    "openandhome"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "sensorbox",
        "label": "Sensorbox",
        "type": "query",
        "datasource": {
          "type": "influxdb",
          "uid": "oh-messwerte"
        },
        "query": "SHOW TAG VALUES FROM \"openandhome\" WITH KEY = \"sensorbox\"",
        "definition": "SHOW TAG VALUES FROM \"openandhome\" WITH KEY = \"sensorbox\"",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      }
    ]
  },
  "panels": [
    {
      "type": "timeseries",
      "title": "Temperatur",
      "description": "",
      "datasource": {
        "type": "influxdb",
        "uid": "oh-messwerte"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "oh-messwerte"
          },
          "refId": "A",
          "rawQuery": true,
          "query": "SELECT mean(\"value\") FROM \"openandhome\" WHERE \"valuename\" =~ /^Temperat/ AND \"sensorbox\" =~ /^$sensorbox$/ AND $timeFilter GROUP BY time($__interval), \"sensorbox\", \"device\" fill(null)",
          "resultFormat": "time_series",
          "alias": "$tag_sensorbox $tag_device"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "custom": {
            "lineWidth": 2,
            "spanNulls": 3600000,
            "lineInterpolation": "smooth"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "min",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
