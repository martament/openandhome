                      "group": "influxdb",
                      "version": "v0",
                      "datasource": {
                        "name": "oh-messwerte"
                      },
                      "spec": {
                        "alias": "$tag_sensorbox $tag_device",
                        "query": "SELECT mean(\"value\") FROM \"openandhome\" WHERE \"valuename\" =~ /^(Distance|Abstand)$/ AND \"sensorbox\" =~ /^$sensorbox$/ AND $timeFilter GROUP BY time($__interval), \"sensorbox\", \"device\" fill(null)",
                        "rawQuery": true,
                        "resultFormat": "time_series"
                      }
                    }
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "",
            "spec": {
              "options": {
                "legend": {
                  "displayMode": "table",
                  "placement": "bottom",
                  "calcs": [
                    "lastNotNull",
                    "min",
                    "max"
                  ]
                },
                "tooltip": {
                  "mode": "multi",
                  "sort": "desc"
                }
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "suffix: cm",
                  "custom": {
                    "lineWidth": 2,
                    "spanNulls": 3600000,
                    "lineInterpolation": "smooth"
                  }
                },
                "overrides": []
              }
            }
          }
        }
      },
      "panel-4": {
        "kind": "Panel",
        "spec": {
          "id": 4,
          "title": "Wassersensor",
          "description": "Wassersensor, 1 = Wasser erkannt (je nach Verdrahtung). Nur sichtbar, wenn eine gewählte Box diesen Wert sendet.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "refId": "A",
                    "hidden": false,
                    "query": {
                      "kind": "DataQuery",
                      "group": "influxdb",
                      "version": "v0",
                      "datasource": {
                        "name": "oh-messwerte"
                      },
                      "spec": {
                        "alias": "$tag_sensorbox $tag_device",
                        "query": "SELECT mean(\"value\") FROM \"openandhome\" WHERE \"valuename\" =~ /^(State)$/ AND \"sensorbox\" =~ /^$sensorbox$/ AND $timeFilter GROUP BY time($__interval), \"sensorbox\", \"device\" fill(null)",
                        "rawQuery": true,
                        "resultFormat": "time_series"
                      }
                    }
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "",
            "spec": {
              "options": {
                "legend": {
                  "displayMode": "table",
                  "placement": "bottom",
                  "calcs": [
                    "lastNotNull",
                    "min",
                    "max"
                  ]
                },
                "tooltip": {
                  "mode": "multi",
                  "sort": "desc"
                }
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "",
                  "custom": {
                    "lineWidth": 2,
                    "spanNulls": 3600000,
                    "lineInterpolation": "stepAfter"
                  },
                  "min": 0,
                  "max": 1
                },
                "overrides": []
              }
            }
          }
        }
      }
    },
    "links": [
      {
        "type": "dashboards",
        "tags": [
          "openandhome"
        ],
        "asDropdown": true,
        "title": "openandhome",
        "includeVars": true,
        "keepTime": true,
        "icon": "",
        "tooltip": "",
        "targetBlank": false
      }
    ],
    "timeSettings": {
      "timezone": "browser",
      "from": "now-24h",
      "to": "now",
      "autoRefresh": "1m",
      "hideTimepicker": false,
      "fiscalYearStartMonth": 0,
      "autoRefreshIntervals": [
        "10s",
        "30s",
        "1m",
        "5m",
        "15m",
        "30m",
        "1h"
      ]
    },
    "layout": {
      "kind": "AutoGridLayout",
      "spec": {
        "maxColumnCount": 1,
        "columnWidthMode": "standard",
