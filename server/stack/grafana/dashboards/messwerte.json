{
  "apiVersion": "dashboard.grafana.app/v2",
  "kind": "Dashboard",
  "metadata": {
    "name": "oh-messwerte"
  },
  "spec": {
    "title": "Sensorboxen – Messwerte",
    "description": "Luftfeuchte, Abstand und Wassersensor erscheinen nur, wenn eine der gewählten Sensorboxen diesen Messwert im gewählten Zeitraum gesendet hat.",
    "tags": [
      "openandhome"
    ],
    "editable": true,
    "cursorSync": "Off",
    "liveNow": false,
    "preload": false,
    "annotations": [],
    "variables": [
      {
        "kind": "QueryVariable",
        "spec": {
          "name": "sensorbox",
          "label": "Sensorbox",
          "current": {
            "text": [
              "All"
            ],
            "value": [
              "$__all"
            ]
          },
          "hide": "dontHide",
          "refresh": "onTimeRangeChanged",
          "skipUrlSync": false,
          "query": {
            "kind": "DataQuery",
            "group": "influxdb",
            "version": "v0",
            "datasource": {
              "name": "oh-messwerte"
            },
            "spec": {
              "__legacyStringValue": "SHOW TAG VALUES FROM \"openandhome\" WITH KEY = \"sensorbox\""
            }
          },
          "regex": "",
          "sort": "alphabeticalAsc",
          "definition": "SHOW TAG VALUES FROM \"openandhome\" WITH KEY = \"sensorbox\"",
          "options": [],
          "multi": true,
          "includeAll": true,
          "allowCustomValue": true
        }
      }
    ],
    "elements": {
      "panel-1": {
        "kind": "Panel",
        "spec": {
          "id": 1,
          "title": "Temperatur",
          "description": "",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "refId": "A",
                    "hidden": false,
                    "query": {
                      "kind": "DataQuery",
                      "group": "influxdb",
                      "version": "v0",
                      "datasource": {
                        "name": "oh-messwerte"
                      },
                      "spec": {
                        "alias": "$tag_sensorbox $tag_device",
                        "query": "SELECT mean(\"value\") FROM \"openandhome\" WHERE \"valuename\" =~ /^Temperat/ AND \"sensorbox\" =~ /^$sensorbox$/ AND $timeFilter GROUP BY time($__interval), \"sensorbox\", \"device\" fill(null)",
                        "rawQuery": true,
                        "resultFormat": "time_series"
                      }
                    }
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "",
            "spec": {
              "options": {
                "legend": {
                  "displayMode": "table",
                  "placement": "bottom",
                  "calcs": [
                    "lastNotNull",
                    "min",
                    "max"
                  ]
                },
                "tooltip": {
                  "mode": "multi",
                  "sort": "desc"
                }
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "celsius",
                  "custom": {
                    "lineWidth": 2,
                    "spanNulls": 3600000,
                    "lineInterpolation": "smooth"
                  }
                },
                "overrides": []
              }
            }
          }
        }
      },
      "panel-2": {
        "kind": "Panel",
        "spec": {
          "id": 2,
          "title": "Luftfeuchte",
          "description": "Kombifühler (HTU21D/AM2320). Nur sichtbar, wenn eine gewählte Box diesen Wert sendet.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "refId": "A",
                    "hidden": false,
                    "query": {
                      "kind": "DataQuery",
                      "group": "influxdb",
                      "version": "v0",
                      "datasource": {
                        "name": "oh-messwerte"
                      },
                      "spec": {
                        "alias": "$tag_sensorbox $tag_device",
                        "query": "SELECT mean(\"value\") FROM \"openandhome\" WHERE \"valuename\" =~ /^(Luftfeuchtigkeit|Humidity)$/ AND \"sensorbox\" =~ /^$sensorbox$/ AND $timeFilter GROUP BY time($__interval), \"sensorbox\", \"device\" fill(null)",
                        "rawQuery": true,
                        "resultFormat": "time_series"
                      }
                    }
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "",
            "spec": {
              "options": {
                "legend": {
                  "displayMode": "table",
                  "placement": "bottom",
                  "calcs": [
                    "lastNotNull",
                    "min",
                    "max"
                  ]
                },
                "tooltip": {
                  "mode": "multi",
                  "sort": "desc"
                }
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "humidity",
                  "custom": {
                    "lineWidth": 2,
                    "spanNulls": 3600000,
                    "lineInterpolation": "smooth"
                  }
                },
                "overrides": []
              }
            }
          }
        }
      },
      "panel-3": {
        "kind": "Panel",
        "spec": {
          "id": 3,
          "title": "Abstand",
          "description": "Ultraschall-Abstandssensor HC-SR04. Nur sichtbar, wenn eine gewählte Box diesen Wert sendet.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "refId": "A",
                    "hidden": false,
                    "query": {
