{
  "uid": "oh-boxsystem",
  "title": "Sensorboxen – System",
  "tags": [
    "openandhome"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "1m",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "sensorbox",
        "label": "Sensorbox",
        "type": "query",
        "datasource": {
          "type": "influxdb",
          "uid": "oh-messwerte"
        },
        "query": "SHOW TAG VALUES FROM \"openandhome\" WITH KEY = \"sensorbox\"",
        "definition": "SHOW TAG VALUES FROM \"openandhome\" WITH KEY = \"sensorbox\"",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      }
    ]
  },
  "panels": [
    {
      "type": "state-timeline",
      "title": "Online-Status",
      "datasource": {
        "type": "influxdb",
        "uid": "oh-messwerte"
      },
      "description": "Meldung der Box an den MQTT-Broker (LWT): Connected = online",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "oh-messwerte"
          },
          "refId": "A",
          "rawQuery": true,
          "query": "SELECT last(\"value\") FROM \"openandhome_status\" WHERE \"sensorbox\" =~ /^$sensorbox$/ AND $timeFilter GROUP BY time($__interval), \"sensorbox\" fill(previous)",
          "resultFormat": "time_series",
          "alias": "$tag_sensorbox"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "Connected": {
                  "text": "online",
                  "color": "green",
                  "index": 0
                },
                "Connection Lost": {
                  "text": "offline",
                  "color": "red",
                  "index": 1
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "showValue": "never",
        "mergeValues": true,
        "alignValue": "left"
      }
    },
    {
      "type": "timeseries",
      "title": "WLAN-Signal",
      "description": "",
      "datasource": {
        "type": "influxdb",
        "uid": "oh-messwerte"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "oh-messwerte"
          },
          "refId": "A",
          "rawQuery": true,
          "query": "SELECT mean(\"value\") FROM \"openandhome\" WHERE \"valuename\" = 'rssi' AND \"sensorbox\" =~ /^$sensorbox$/ AND $timeFilter GROUP BY time($__interval), \"sensorbox\" fill(null)",
          "resultFormat": "time_series",
          "alias": "$tag_sensorbox"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "dBm",
          "custom": {
            "lineWidth": 2,
            "spanNulls": 3600000,
            "lineInterpolation": "smooth"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "min",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
